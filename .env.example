HOST=127.0.0.1
PORT=3001
DNSMGR_UPSTREAM_URL=http://127.0.0.1:8081/
DNSMGR_UPSTREAM_HOST=
DNSMGR_UPSTREAM_VERSION=1051
DNSMGR_REQUEST_TIMEOUT_MS=15000
DNSMGR_CAS_LOGIN_PATH=/cas/login
DNSMGR_CAS_LOGOUT_PATH=/cas/logout
DNSMGR_CAS_JWT_COOKIE=resty_cas_jwt
# Enable this in the SSO deployment so both CAS and the legacy user_token are required.
DNSMGR_REQUIRE_CAS_JWT=true
DNSMGR_CAS_JWT_SECRET=
