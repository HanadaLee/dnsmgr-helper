{
  "server": {
    "environment": "production",
    "host": "127.0.0.1",
    "port": 19102,
    "publicUrl": "https://dns.example.com/"
  },
  "upstream": {
    "url": "http://127.0.0.1:19101/",
    "host": "dns.example.com",
    "version": "1051",
    "requestTimeoutMs": 15000
  },
  "releaseCheck": {
    "enabled": true,
    "url": "https://auth.cccyun.cc/app/dnsmgr.php",
    "requestTimeoutMs": 10000
  },
  "cas": {
    "enabled": false,
    "baseUrl": "https://cas.example.com/cas/organization/application/",
    "validationUrl": "",
    "validationHost": "",
    "loginPath": "/cas/login",
    "callbackPath": "/cas/callback",
    "logoutPath": "/cas/logout",
    "logoutRedirectPath": "/",
    "requestTimeoutMs": 15000,
    "attributes": {
      "user": "user",
      "email": "email",
      "displayName": "displayName",
      "avatar": "avatar"
    }
  },
  "oidc": {
    "enabled": false,
    "issuer": "https://id.example.com",
    "clientId": "",
    "clientSecret": "",
    "logoutUrl": "",
    "usernameClaim": "preferred_username",
    "requestTimeoutMs": 15000
  },
  "auth": {
    "requiredProvider": "any",
    "sessionCookie": "dnsmgr_helper_session",
    "sessionSecret": "",
    "sessionTtlSeconds": 604800,
    "cookieSecure": true,
    "cookieSameSite": "lax",
    "cookieDomain": ""
  },
  "database": {
    "enabled": false,
    "thinkphpEnvPath": "/app/config/thinkphp.env",
    "connectionLimit": 5,
    "connectTimeoutMs": 10000,
    "ssl": false
  }
}
