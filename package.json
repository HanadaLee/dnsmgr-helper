{
  "name": "dnsmgr-helper",
  "private": true,
  "version": "0.8.16",
  "description": "Compatibility BFF for a stock dnsmgr installation",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "config:check": "tsx src/config-check.ts",
    "dev": "tsx watch src/server.ts",
    "mock:upstream": "tsx test/fixtures/mock-upstream.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "dnsmgr",
    "bff",
    "compatibility"
  ],
  "dependencies": {
    "@fastify/formbody": "^9.0.0",
    "@fastify/helmet": "^13.1.1",
    "fast-xml-parser": "^5.11.1",
    "fastify": "^5.12.1",
    "jose": "^6.2.10",
    "mysql2": "^3.24.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
